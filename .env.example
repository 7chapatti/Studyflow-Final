NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

NEXT_PUBLIC_APP_URL=

CRON_SECRET=

# "Continue with Google" on the login and signup pages. Leave unset until the
# Google provider is enabled in Supabase (Authentication > Providers), then
# set to true. The button is hidden otherwise.
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=

# Google Calendar sync (optional: the settings section stays hidden until
# all three are set). Client ID/secret come from a Google Cloud OAuth
# "Web application" client whose authorised redirect URI is
#   <NEXT_PUBLIC_APP_URL>/api/google/calendar/callback
# The encryption key protects stored Google tokens; generate one with
#   openssl rand -base64 32
# and never change it afterwards, or existing connections stop working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
